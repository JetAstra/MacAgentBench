      },
      "rule": {
        "type": "common",
        "func": "is_true",
        "parameters": []
      }
    },
    {
      "name": "has_report1",
      "weight": 0.25,
      "capability": "app_state",
      "func": "notes_list_attachment_names_by_note_name",
      "parameters": {
        "note_name": "reports"
      },
      "rule": {
        "type": "common",
        "func": "ratio_match",
