{
  "id": "finder_multi_3_3",
  "system_img": "default",
  "instruction": "Could you search for every .sh file modified within the last 7 days? Using the terminal, locate these shell scripts and save their file paths into a text file called \"SH_modified_in_last_7_days.txt\" in the ~/Library/Saved directory.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "mkdir -p ~/Library/Saved",
          "echo '#!/bin/bash' > ~/Documents/build.sh",
          "echo '#!/bin/bash' > /Users/Shared/deploy.sh",
          "echo '#!/bin/bash' > /Users/Shared/cleanup.sh",
          "echo '#!/bin/bash' > ~/Documents/setup.sh"
        ]
      }
    }
  ],
  "related_apps": [
    "finder",
    "terminal"
  ],
