{
  "id": "notes_multi_2_4",
  "system_img": "default",
  "instruction": "Open the Calendar app and find the event that is set for September 5, 2050. After that, switch to the Notes app and create a new folder whose name matches the title of that calendar event, then place a minimum of two notes within that folder.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Notes'",
          "osascript -e 'tell application \"Calendar\"' -e 'if not (exists calendar \"Strategy Meetings\") then make new calendar with properties {name:\"Strategy Meetings\"}' -e 'tell calendar \"Strategy Meetings\"' -e 'make new event with properties {summary:\"Strategy Meeting\", start date:date \"September 5, 2050 at 9:00 AM\", end date:date \"September 5, 2050 at 10:00 AM\"}' -e 'end tell' -e 'end tell'"
        ]
      }
    }
  ],
  "related_apps": [
    "notes"
  ],
  "evaluator": {
