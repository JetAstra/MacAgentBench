{
  "id": "finder_multi_3_4",
  "system_img": "default",
  "instruction": "Please search for every .json file that has been modified within the last 7 days. Use the terminal to find these JSON files and save their file paths to a text file called \"JSON_modified_in_last_7_days.txt\" located in the ~/Library/Saved directory.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "mkdir -p ~/Library/Saved",
          "echo '{\"name\": \"test\"}' > ~/Documents/config.json",
          "echo '{\"key\": \"value\"}' > /Users/Shared/settings.json",
          "echo '{\"id\": 1}' > ~/Documents/manifest.json",
          "echo '{\"version\": 2}' > /Users/Shared/package.json"
        ]
      }
    }
  ],
