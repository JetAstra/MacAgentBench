{
  "id": "reminders_multi_5_2",
  "system_img": "default",
  "instruction": "Use the Terminal app to determine the current Safari version installed on this Mac. In the Safari app, look up the release year of that Safari version. Then open the Reminders app, create a list named \"Apple Systems\", and add a reminder titled \"Safari {version} Release\" with the due date set to that release year.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Reminders'"
        ]
      }
    }
  ],
  "related_apps": [
    "reminders"
  ],
  "evaluator": {
    "func": [
      "reminders_get_due_year"
    ],
    "conj": "and",
    "parameters": [
      {
        "reminder_name": "Safari 26.3 Release",
        "list_name": "Apple Systems"
      }
    ],
    "expected": [
      {
        "type": "common",
        "rules": {
          "func": "exact_match",
          "parameters": [
            2026
          ]
        }
      }
    ]
  },
  "scoring_components": [
    {
      "name": "list_exists",
      "weight": 0.2,
      "capability": "app_state",
      "func": "new_reminders_check_list_exists",
      "parameters": {
        "list_name": "Apple Systems"
      },
      "rule": {
        "type": "common",
        "func": "is_true",
        "parameters": []
      }
    },
    {
      "name": "has_keyword",
      "weight": 0.2,
      "capability": "research",
      "func": "reminders_get_titles_in_list",
      "parameters": {
        "list_name": "Apple Systems"
      },
      "rule": {
        "type": "common",
        "func": "ratio_match",
        "parameters": [
          [
            "Safari"
          ]
        ]
      }
    },
    {
      "name": "has_release",
      "weight": 0.2,
      "capability": "content_match",
      "func": "reminders_get_titles_in_list",
      "parameters": {
        "list_name": "Apple Systems"
      },
      "rule": {
        "type": "common",
        "func": "ratio_match",
        "parameters": [
          [
            "Release"
          ]
        ]
      }
    },
    {
      "name": "reminder_exact",
      "weight": 0.2,
      "capability": "content_match",
      "func": "new_reminders_check_reminder_exists_in_list",
      "parameters": {
        "title": "Safari 26.3 Release",
        "list_name": "Apple Systems"
      },
      "rule": {
        "type": "common",
        "func": "is_true",
        "parameters": []
      }
    },
    {
      "name": "due_year_exact",
      "weight": 0.2,
      "capability": "research",
      "func": "reminders_get_due_year",
      "parameters": {
        "reminder_name": "Safari 26.3 Release",
        "list_name": "Apple Systems"
      },
      "rule": {
        "type": "common",
        "func": "exact_match",
        "parameters": [
          2026
        ]
      }
    }
  ]
}