{
  "id": "finder_multi_3_2",
  "system_img": "default",
  "instruction": "Search for all .csv files modified in the last 7 days using the terminal. Write their file paths into a text file named \"CSV_modified_in_last_7_days.txt\" in the ~/Library/Saved directory.",
