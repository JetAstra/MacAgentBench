{
  "id": "notes_multi_2_2",
  "system_img": "default",
  "instruction": "Open the Calendar app and find the event on July 15, 2050. In the Notes app, create a folder with that event's title as its name, then add at least two notes inside it.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Notes'",
          "osascript -e 'tell application \"Calendar\"' -e 'if not (exists calendar \"Project Reviews\") then make new calendar with properties {name:\"Project Reviews\"}' -e 'tell calendar \"Project Reviews\"' -e 'make new event with properties {summary:\"Project Review\", start date:date \"July 15, 2050 at 10:00 AM\", end date:date \"July 15, 2050 at 11:00 AM\"}' -e 'end tell' -e 'end tell'"
        ]
      }
    }
  ],
  "related_apps": [
    "notes"
  ],
  "evaluator": {
