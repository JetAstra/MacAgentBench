    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Reminders'",
          "echo 'This is Document A' > ~/Documents/report_111.txt",
          "cupsfilter ~/Documents/report_111.txt > ~/Documents/report_222.pdf 2>/dev/null"
        ]
      }
    }
  ],
