{
  "id": "notes_multi_2_3",
  "system_img": "default",
  "instruction": "Open the Calendar app and find the event that is scheduled for August 20, 2050; after that, switch to the Notes app, where you should create a folder whose name matches the title of that event and place at least two notes within it.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Notes'",
          "osascript -e 'tell application \"Calendar\"' -e 'if not (exists calendar \"Design Sprints\") then make new calendar with properties {name:\"Design Sprints\"}' -e 'tell calendar \"Design Sprints\"' -e 'make new event with properties {summary:\"Design Sprint\", start date:date \"August 20, 2050 at 2:00 PM\", end date:date \"August 20, 2050 at 3:00 PM\"}' -e 'end tell' -e 'end tell'"
        ]
      }
    }
  ],
  "related_apps": [
