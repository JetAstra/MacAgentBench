{
  "id": "reminders_multi_5_1",
  "system_img": "default",
  "instruction": "In the Terminal app, find the current macOS version and determine its version name (e.g., Ventura, Sonoma); in the Safari app, look up the release year of that macOS version; then in the Reminders app, create a list named \"Apple Systems\" and add a reminder titled \"{macOS Version Name} Release\" (with the first letter capitalized) with its due date set to that release year.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Reminders'"
        ]
      }
    }
  ],
  "related_apps": [
    "reminders"
  ],
  "evaluator": {
    "func": [
      "reminders_get_due_year"
    ],
    "conj": "and",
    "parameters": [
