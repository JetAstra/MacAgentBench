{
  "id": "reminders_multi_3_2",
  "system_img": "default",
  "instruction": "Open the Finder app and find a PDF file at ~/Documents. Then, in the Reminders app, create a reminder whose name matches that PDF's filename without the \".pdf\" extension, set it due next week at 10:00 AM.",
