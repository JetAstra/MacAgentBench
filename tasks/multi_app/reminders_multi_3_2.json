    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Reminders'",
          "echo 'This is Document B' > ~/Documents/document_333.txt",
          "cupsfilter ~/Documents/document_333.txt > ~/Documents/document_333.pdf 2>/dev/null"
        ]
      }
    }
  ],
