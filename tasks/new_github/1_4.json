{
  "id": "new_github_1_4",
  "system_img": "default",
  "instruction": "Look up the \"torvalds/linux\" repository and retrieve its full_name, description, license_name, homepage_url, and main_language. Afterward, write this information to \"$HOME/Desktop/gh_repo_info_1_4.txt\".",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "open -a 'Terminal'"
        ]
      }
    }
  ],
  "related_apps": [
    "terminal_no_reset"
  ],
  "reference_command": "gh api repos/torvalds/linux --jq '\"full_name: \\(.full_name)\\ndescription: \\(.description // \"\")\\nlicense_name: \\(.license.name // \"NO LICENSE\")\\nhomepage_url: \\(.homepage // \"\")\\nmain_language: \\(.language // \"\")\"' > \"$HOME/Desktop/gh_repo_info_1_4.txt\"",
  "evaluator": {
    "func": [
      "new_github_check_repo_info_matches"
    ],
    "conj": "and",
    "parameters": [
      {
        "output_file": "$HOME/Desktop/gh_repo_info_1_4.txt",
        "repo": "torvalds/linux"
      }
    ],
    "expected": [
      {
        "type": "common",
        "rules": {
          "func": "is_true",
          "parameters": []
        }
      }
    ]
  }
}
