{
  "id": "new_video_frames_3_4",
  "system_img": "default",
  "necessary": false,
  "instruction": "Using Terminal, pull out the frame located at 00:00:04 from \"$HOME/Desktop/benchmark_source.mp4\", stretch it directly to 854x480 without preserving aspect ratio, and store the result as \"$HOME/Desktop/vf_thumb_4.png\".",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "rm -f \"$HOME/Desktop/vf_thumb_4.png\"",
          "open -a 'Terminal'"
        ]
      }
    }
  ],
  "related_apps": [
    "terminal_no_reset"
  ],
  "reference_command": "ffmpeg -y -ss \"00:00:04\" -i \"$HOME/Desktop/benchmark_source.mp4\" -vf \"scale=854:480\" -frames:v 1 -update 1 \"$HOME/Desktop/vf_thumb_4.png\" >/dev/null 2>&1 && sleep 1",
  "evaluator": {
    "func": [
      "new_video_frames_check_scaled_frame_matches_expected"
    ],
    "conj": "and",
    "parameters": [
      {
        "output_file": "$HOME/Desktop/vf_thumb_4.png",
        "input_video": "$HOME/Desktop/benchmark_source.mp4",
        "timestamp": "00:00:04",
        "width": 854,
        "height": 480
      }
    ],
    "expected": [
      {
        "type": "common",
        "rules": {
          "func": "is_true",
          "parameters": []
        }
      }
    ]
  }
}
