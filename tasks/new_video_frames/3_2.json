{
  "id": "new_video_frames_3_2",
  "system_img": "default",
  "necessary": false,
  "instruction": "Using Terminal, pull a frame at 00:00:02 from \"$HOME/Desktop/benchmark_source.mp4\", stretch it directly to 480x270 without preserving aspect ratio, and export it as \"$HOME/Desktop/vf_thumb_2.png\".",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "rm -f \"$HOME/Desktop/vf_thumb_2.png\"",
          "open -a 'Terminal'"
        ]
      }
    }
  ],
  "related_apps": [
    "terminal_no_reset"
  ],
  "reference_command": "ffmpeg -y -ss \"00:00:02\" -i \"$HOME/Desktop/benchmark_source.mp4\" -vf \"scale=480:270\" -frames:v 1 -update 1 \"$HOME/Desktop/vf_thumb_2.png\" >/dev/null 2>&1 && sleep 1",
  "evaluator": {
    "func": [
      "new_video_frames_check_scaled_frame_matches_expected"
    ],
    "conj": "and",
    "parameters": [
      {
        "output_file": "$HOME/Desktop/vf_thumb_2.png",
        "input_video": "$HOME/Desktop/benchmark_source.mp4",
        "timestamp": "00:00:02",
        "width": 480,
        "height": 270
      }
    ],
    "expected": [
      {
        "type": "common",
        "rules": {
          "func": "is_true",
          "parameters": []
        }
      }
    ]
  }
}
