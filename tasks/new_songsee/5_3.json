{
  "id": "new_songsee_5_3",
  "system_img": "default",
  "necessary": false,
  "instruction": "Within Terminal, run songsee to create a spectrogram of \"$HOME/Desktop/Ode to Joy.mp3\", setting the width to 1440 and the height to 810, and saving the output as \"$HOME/Desktop/songsee_sized_3.png\".",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "rm -f \"$HOME/Desktop/songsee_sized_3.png\"",
          "open -a 'Terminal'"
        ]
      }
    }
  ],
  "related_apps": [
    "terminal_no_reset"
  ],
  "reference_command": "songsee \"$HOME/Desktop/Ode to Joy.mp3\" --width 1440 --height 810 -o \"$HOME/Desktop/songsee_sized_3.png\"",
