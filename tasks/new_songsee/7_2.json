{
  "id": "new_songsee_7_2",
  "system_img": "default",
  "necessary": false,
  "instruction": "In Terminal, run songsee to create a spectrogram of \"$HOME/Desktop/Ode to Joy.mp3\" displaying only the frequency range from 100 Hz to 6000 Hz, and save the output to \"$HOME/Desktop/songsee_freq_2.png\".",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "rm -f \"$HOME/Desktop/songsee_freq_2.png\"",
          "open -a 'Terminal'"
        ]
      }
    }
  ],
  "related_apps": [
    "terminal_no_reset"
  ],
  "reference_command": "songsee \"$HOME/Desktop/Ode to Joy.mp3\" --min-freq 100 --max-freq 6000 -o \"$HOME/Desktop/songsee_freq_2.png\"",
