      {
        "output_file": "$HOME/Desktop/songsee_freq_2.png",
        "input_audio": "$HOME/Desktop/Ode to Joy.mp3",
        "image_format": "png",
        "min_freq": 100,
        "max_freq": 6000
      }
    ],
    "expected": [
      {
        "type": "common",
        "rules": {
          "func": "is_true",
          "parameters": []
        }
      }
    ]
  }
