{
  "id": "new_tmux_5_4",
  "system_img": "default",
  "necessary": false,
  "instruction": "Using Terminal, transmit `7` to the tmux session that is presently awaiting confirmation.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "tmux kill-session -t \"tmux-confirm-idle-d4\" 2>/dev/null || true",
          "tmux kill-session -t \"tmux-confirm-target-d4\" 2>/dev/null || true",
          "tmux kill-session -t \"tmux-confirm-other-d4\" 2>/dev/null || true",
          "tmux new-session -d -s \"tmux-confirm-idle-d4\" \"printf '%s\\\\n' 'staging deploy: idle' 'TMUX_IDLE_MARKER_5D'; tail -f /dev/null\"",
          "tmux new-session -d -s \"tmux-confirm-target-d4\" \"python3 -u -c 'import sys,time; print(\\\"Type 7 to continue\\\", flush=True); print(\\\"TMUX_CONFIRM_PROMPT_5D\\\", flush=True); line=sys.stdin.readline().rstrip(\\\"\\\\r\\\\n\\\"); print(\\\"TMUX_CONFIRMED_5D\\\", flush=True) if line==\\\"7\\\" else print(\\\"TMUX_REJECTED_5D\\\", flush=True); time.sleep(3600)'\"",
          "tmux new-session -d -s \"tmux-confirm-other-d4\" \"printf '%s\\\\n' 'ticket poller: running' 'TMUX_OTHER_MARKER_5D'; tail -f /dev/null\"",
          "open -a 'Terminal'"
        ]
      }
    }
  ],
  "related_apps": [
    "terminal_no_reset"
  ],
  "reference_command": "tmux send-keys -t \"tmux-confirm-target-d4\" '7' Enter",
  "evaluator": {
    "func": [
      "new_tmux_check_pane_contains_text"
    ],
    "conj": "and",
    "parameters": [
      {
        "target": "tmux-confirm-target-d4",
        "expected_text": "TMUX_CONFIRMED_5D"
      }
    ],
    "expected": [
      {
        "type": "common",
        "rules": {
          "func": "is_true",
          "parameters": []
        }
      }
    ]
  }
}
