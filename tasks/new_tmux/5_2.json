{
  "id": "new_tmux_5_2",
  "system_img": "default",
  "necessary": false,
  "instruction": "Using Terminal, send `approve` to the tmux session currently awaiting confirmation.",
  "config": [
    {
      "type": "cmd",
      "parameters": {
        "command": [
          "tmux kill-session -t \"tmux-confirm-idle-d2\" 2>/dev/null || true",
          "tmux kill-session -t \"tmux-confirm-target-d2\" 2>/dev/null || true",
          "tmux kill-session -t \"tmux-confirm-other-d2\" 2>/dev/null || true",
          "tmux new-session -d -s \"tmux-confirm-idle-d2\" \"printf '%s\\\\n' 'cache sweep: idle' 'TMUX_IDLE_MARKER_5B'; tail -f /dev/null\"",
          "tmux new-session -d -s \"tmux-confirm-target-d2\" \"python3 -u -c 'import sys,time; print(\\\"Type approve to continue\\\", flush=True); print(\\\"TMUX_CONFIRM_PROMPT_5B\\\", flush=True); line=sys.stdin.readline().rstrip(\\\"\\\\r\\\\n\\\"); print(\\\"TMUX_CONFIRMED_5B\\\", flush=True) if line==\\\"approve\\\" else print(\\\"TMUX_REJECTED_5B\\\", flush=True); time.sleep(3600)'\"",
          "tmux new-session -d -s \"tmux-confirm-other-d2\" \"printf '%s\\\\n' 'renderer: running' 'TMUX_OTHER_MARKER_5B'; tail -f /dev/null\"",
          "open -a 'Terminal'"
        ]
      }
    }
  ],
  "related_apps": [
    "terminal_no_reset"
  ],
  "reference_command": "tmux send-keys -t \"tmux-confirm-target-d2\" 'approve' Enter",
  "evaluator": {
    "func": [
      "new_tmux_check_pane_contains_text"
    ],
    "conj": "and",
    "parameters": [
      {
        "target": "tmux-confirm-target-d2",
        "expected_text": "TMUX_CONFIRMED_5B"
      }
    ],
    "expected": [
      {
        "type": "common",
        "rules": {
          "func": "is_true",
          "parameters": []
        }
      }
    ]
  }
}
